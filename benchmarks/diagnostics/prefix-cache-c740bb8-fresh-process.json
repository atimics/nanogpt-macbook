  "runner_source": "import argparse\nimport json\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--worker', choices=['reference', 'updated'])\nparser.add_argument('--preset', default='tiny')\nparser.add_argument('--out', type=Path, default=Path('/private/tmp/ngpt-prefix-cache-c740bb8-cold.json'))\nargs = parser.parse_args()\nsys.path.insert(0, '/private/tmp/nanogpt-macbook-build/scripts')\n\nif args.worker:\n    from compare_sampling import reference_modules, sample\n    from nanogpt_macbook import engine\n    from nanogpt_macbook.config import PRESETS\n    from nanogpt_macbook.model import GPT\n    engine.select_device('gpu', 2)\n    reference, _ = reference_modules('df39732')\n    opts = argparse.Namespace(tokens=200, temperature=0.8, top_k=40, seed=42)\n    cls, module = (reference['model'].GPT, reference['engine']) if args.worker == 'reference' else (GPT, engine)\n    print(json.dumps(sample(cls, module, PRESETS[args.preset][0], 'After the rain, ', opts)))\nelse:\n    assert not args.out.exists()\n    rows = []\n    for preset in ['tiny', 'small', 'medium']:\n        for pair in range(5):\n            for name in ['reference', 'updated'] if pair % 2 == 0 else ['updated', 'reference']:\n                start = time.perf_counter()\n                proc = subprocess.run([sys.executable, __file__, '--worker', name, '--preset', preset], text=True, capture_output=True, check=True)\n                row = dict(preset=preset, pair=pair+1, path=name, process_seconds=time.perf_counter()-start, **json.loads(proc.stdout))\n                rows.append(row)\n                args.out.write_text(json.dumps(dict(reference='df39732', source='c740bb8', prompt='After the rain, ', generated_bytes=200, method='Each path uses a fresh process; model load is outside generation timer; complete process time is also recorded.', results=rows), indent=2)+'\\n')\n            print(preset, pair+1, 'saved', flush=True)\n",
