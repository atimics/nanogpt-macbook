  "runner_source": "import hashlib\nimport json\nimport sys\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nimport mlx.core as mx\n\nfrom nanogpt_macbook import checkpoint, engine\nfrom nanogpt_macbook.benchmark import source_info\nfrom nanogpt_macbook.config import ModelConfig\nfrom nanogpt_macbook.data import decode\nfrom nanogpt_macbook.model import GPT\n\nsys.path.insert(0, '/private/tmp/nanogpt-macbook-build/scripts')\nfrom compare_sampling import reference_modules\n\nout = Path('/private/tmp/ngpt-prefix-cache-c740bb8-trained.json')\nassert not out.exists()\nreference, source = reference_modules('df39732')\nengine.select_device('gpu', 2)\nreceipt = dict(source=source_info(), reference=source, method=dict(generated_bytes=200, temperatures=[0, 0.8], seeds=[9, 42, 1337], top_k=40), checkpoints=[], results=[])\nfor preset in ['tiny', 'small', 'medium']:\n    run = Path(f'/private/tmp/ngpt-attention-values-1203504-{preset}-seed1337-run')\n    path, state = checkpoint.read(run, 'best')\n    weights = path / 'model.safetensors'\n    config = ModelConfig(**state['model_config'])\n    receipt['checkpoints'].append(dict(preset=preset, model_config=state['model_config'], step=state['step'], weights_sha256=hashlib.sha256(weights.read_bytes()).hexdigest()))\n    models = [('reference', reference['model'].GPT(config), reference['engine']), ('updated', GPT(config), engine)]\n    for _, model, _ in models:\n        model.load_weights(str(weights))\n        mx.eval(model.parameters())\n    for length in [16, config.context]:\n        prompt = ('After the rain, Mira opened the window. ' * 20)[:length]\n        for temperature in [0, 0.8]:\n            for seed in [9, 42, 1337]:\n                outputs = {}\n                for name, model, module in models:\n                    generated = []\n                    def capture(tokens):\n                        generated.extend(tokens)\n                        return decode(tokens)\n                    with patch.object(module, 'decode', capture):\n                        text = module.generate(model, prompt, 200, temperature, 40, seed)\n                    outputs[name] = generated\n                same = outputs['reference'] == outputs['updated']\n                row = dict(preset=preset, prompt_bytes=length, temperature=temperature, seed=seed, same_bytes=same, hashes={p:hashlib.sha256(bytes(v)).hexdigest() for p,v in outputs.items()})\n                if not same:\n                    row['first_difference'] = next(i for i,(a,b) in enumerate(zip(outputs['reference'],outputs['updated'],strict=True)) if a!=b)\n                    row['bytes'] = outputs\n                receipt['results'].append(row)\n                out.write_text(json.dumps(receipt,indent=2))\n        print(preset, length, 'trained comparisons saved', flush=True)\n    del models, model\nprint('Matching trained pairs:', sum(r['same_bytes'] for r in receipt['results']), '/', len(receipt['results']), flush=True)\n"
}
