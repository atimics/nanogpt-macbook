  "runner_source": "import gc\nimport json\nimport statistics\nimport time\nfrom collections import deque\nfrom pathlib import Path\n\nimport mlx.core as mx\nimport mlx.nn as nn\n\nfrom nanogpt_macbook import engine\nfrom nanogpt_macbook.activations import gelu_approx\nfrom nanogpt_macbook.benchmark import source_info\nfrom nanogpt_macbook.config import PRESETS\nfrom nanogpt_macbook.model import GPT, _residual_projection\n\n\nclass AttentionBranch(nn.Module):\n    def __init__(self, block):\n        super().__init__()\n        self.norm = block.attention_norm\n        self.attention = block.attention\n\n    def __call__(self, x):\n        return self.attention(self.norm(x), x)\n\n\nclass MLPBranch(nn.Module):\n    def __init__(self, block):\n        super().__init__()\n        self.norm = block.mlp_norm\n        self.up = block.up\n        self.down = block.down\n\n    def __call__(self, x):\n        return _residual_projection(x, gelu_approx(self.up(self.norm(x))), self.down)\n\n\ndef measure(preset, name, config, training):\n    gc.collect()\n    mx.clear_cache()\n    mx.random.seed(1337)\n    model = GPT(config)\n    block = model.blocks[0]\n    choices = dict(block=block, attention=AttentionBranch(block), mlp=MLPBranch(block), norm=block.attention_norm, qkv=block.attention.qkv, up=block.up, down=block.down)\n    component = choices[name]\n    params = component.parameters()\n    width = 4*config.width if name=='down' else config.width\n    x = mx.random.normal((training.batch_size, config.context, width))\n    dy = mx.random.normal(component(x).shape)\n    mx.eval(params,x,dy)\n    del model,block,choices\n    gc.collect()\n    mx.clear_cache()\n\n    def loss(weights, inputs, upstream):\n        component.update(weights)\n        return (component(inputs)*upstream).sum()\n\n    step = mx.compile(mx.value_and_grad(loss,argnums=(0,1)))\n\n    def run(count):\n        pending=deque()\n        started=time.perf_counter()\n        for _ in range(count):\n            outputs=step(params,x,dy)\n            mx.async_eval(outputs)\n            pending.append(outputs)\n            if len(pending)==2:\n                mx.eval(pending.popleft())\n        while pending: mx.eval(pending.popleft())\n        mx.synchronize()\n        return (time.perf_counter()-started)*1000/count\n\n    run(20)\n    intervals=[run(200) for _ in range(5)]\n    return dict(preset=preset,component=name,input_shape=x.shape,output_shape=dy.shape,step_ms=intervals,median_ms=statistics.median(intervals))\n\n\nout=Path('/private/tmp/ngpt-training-components-7fec185.json')\nassert not out.exists()\nengine.select_device('gpu',2)\nrecord=dict(source=source_info(),method=dict(device='gpu',memory_limit_gib=2,warmup=20,steps=200,repeats=5,queue=2,scope='Isolated compiled forward, parameter gradients, and input gradients. Fixed random inputs and upstream gradients. No optimizer update. Timings guide full-training experiments; component times are not additive.'),runner_source=Path(__file__).read_text(),results=[])\nfor preset,(config,training) in PRESETS.items():\n    for name in ['block','attention','mlp','norm','qkv','up','down']:\n        result=measure(preset,name,config,training)\n        record['results'].append(result)\n        out.write_text(json.dumps(record,indent=2)+'\\n')\n        print(preset,name,round(result['median_ms'],4),'ms',flush=True)\n",
