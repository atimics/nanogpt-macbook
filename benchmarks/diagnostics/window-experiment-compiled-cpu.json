  "prototype_source": "import argparse\nimport inspect\nimport json\nimport sys\nfrom pathlib import Path\nfrom types import ModuleType\n\nimport mlx.core as mx\n\nsys.path.insert(0, '/private/tmp/nanogpt-macbook-build/scripts')\nimport compare_sampling\nfrom nanogpt_macbook import engine\nfrom nanogpt_macbook.benchmark import source_info\nfrom nanogpt_macbook.config import PRESETS\n\n\ndef sample_window(model, window, count, temperature, top_k):\n    def step(state):\n        logits = model(state, last_token_only=True)[0, -1]\n        token = engine._sample_token(logits, temperature, top_k).astype(state.dtype)\n        return mx.concatenate((state[:, 1:], token.reshape(1, 1)), axis=1), token\n\n    step = mx.compile(step, inputs=mx.random.state, outputs=mx.random.state)\n    state = mx.array([window], dtype=mx.int32)\n    generated = []\n    for index in range(count):\n        state, token = step(state)\n        generated.append(token)\n        mx.async_eval(state, token)\n        if index and index % 8 == 0:\n            mx.eval(generated[-8])\n    return mx.stack(generated).tolist()\n\n\ndef candidate():\n    module = ModuleType('queued_engine')\n    module.__dict__.update(engine.__dict__)\n    module.sample_window = sample_window\n    source = inspect.getsource(engine.generate)\n    source = source.replace('    compiled_logits = None', '''    remaining = tokens - len(generated)\n    if len(sequence) >= model.config.context and remaining >= 16:\n        generated.extend(sample_window(model, sequence[-model.config.context:], remaining, temperature, top_k))\n        return prompt + decode(generated)\n    compiled_logits = None''')\n    exec(compile(source, __file__, 'exec'), module.__dict__)\n    return module\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--out', type=Path, required=True)\n    parser.add_argument('--device', choices=['gpu','cpu'], default='gpu')\n    parser.add_argument('--preset', choices=[*PRESETS,'all'], default='all')\n    parser.add_argument('--pairs', type=int, default=5)\n    args = parser.parse_args()\n    assert not args.out.exists()\n    args.tokens, args.temperature, args.top_k, args.seed = 200, 0.8, 40, 42\n    engine.select_device(args.device, 2)\n    reference, info = compare_sampling.reference_modules('7f741e3')\n    compare_sampling.engine = candidate()\n    record = dict(source=source_info(), reference=info, device=args.device, method=dict(pairs=args.pairs, generated_bytes=200, temperature=0.8, top_k=40, sampling_seed=42, weight_seed=1337, timed_work='complete generation after weight load; fresh models in alternating order; shared process backend caches'), prototype_source=Path(__file__).read_text(), results=[])\n    for preset in PRESETS if args.preset=='all' else [args.preset]:\n        config = PRESETS[preset][0]\n        for length in [16, config.context]:\n            prompt = ('After the rain, Mira opened the window. '*20)[:length]\n            compare_sampling.compare(config, preset, prompt, args, reference, record)\n    print(json.dumps({r['preset']+str(r['prompt_bytes']):dict(ratio=r['median_ratio'],matches=r['matching_byte_pairs']) for r in record['results']}),flush=True)\n\n\nif __name__=='__main__':\n    main()\n",
