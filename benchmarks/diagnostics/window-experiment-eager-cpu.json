  "prototype_source": "import argparse\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom types import ModuleType\n\nimport mlx.core as mx\n\nsys.path.insert(0, '/private/tmp/nanogpt-macbook-build/scripts')\nimport compare_sampling\nfrom nanogpt_macbook import engine\nfrom nanogpt_macbook.benchmark import source_info\nfrom nanogpt_macbook.config import PRESETS\n\n\ndef sample_window(model, window, count, temperature, top_k):\n    state = mx.array([window], dtype=mx.int32)\n    generated = []\n    for index in range(count):\n        logits = model(state, last_token_only=True)[0,-1]\n        token = engine._sample_token(logits, temperature, top_k).astype(state.dtype)\n        state = mx.concatenate((state[:,1:],token.reshape(1,1)),axis=1)\n        generated.append(token)\n        mx.async_eval(state,token)\n        if index and index % 8 == 0:\n            mx.eval(generated[-8])\n    return mx.stack(generated).tolist()\n\n\nargs = argparse.Namespace(out=Path('/private/tmp/ngpt-queued-window-eager-cpu.json'),pairs=10,tokens=200,temperature=0.8,top_k=40,seed=42)\nassert not args.out.exists()\nengine.select_device('cpu',2)\nreference, info = compare_sampling.reference_modules('7f741e3')\nmodule = ModuleType('eager_queued_engine')\nmodule.__package__ = 'nanogpt_macbook'\nmodule.sample_window = sample_window\nsource = subprocess.check_output(['git','show','7f741e3:src/nanogpt_macbook/engine.py'],text=True)\nsource = source.replace('    compiled_logits = None', '''    remaining = tokens - len(generated)\n    if len(sequence) >= model.config.context and remaining >= 16:\n        generated.extend(sample_window(model, sequence[-model.config.context:], remaining, temperature, top_k))\n        return prompt + decode(generated)\n    compiled_logits = None''')\nexec(compile(source,__file__,'exec'),module.__dict__)\ncompare_sampling.engine = module\nrecord = dict(source=source_info(),reference=info,device='cpu',method=dict(pairs=10,generated_bytes=200,temperature=0.8,top_k=40,sampling_seed=42,weight_seed=1337,timed_work='complete generation after weight load; alternating fresh models; eager queued windows; shared process'),prototype_source=Path(__file__).read_text(),results=[])\nconfig = PRESETS['tiny'][0]\nfor length in [16,config.context]:\n    prompt = ('After the rain, Mira opened the window. '*20)[:length]\n    compare_sampling.compare(config,'tiny',prompt,args,reference,record)\nprint(json.dumps({str(r['prompt_bytes']):dict(ratio=r['median_ratio'],matches=r['matching_byte_pairs']) for r in record['results']}),flush=True)\n",
