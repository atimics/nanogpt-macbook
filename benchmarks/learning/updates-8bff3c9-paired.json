  "runner_source": "import gc\nimport json\nfrom dataclasses import replace\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nimport mlx.core as mx\nimport numpy as np\n\nfrom nanogpt_macbook import checkpoint, engine\nfrom nanogpt_macbook.benchmark import source_info\nfrom nanogpt_macbook.config import PRESETS\nfrom nanogpt_macbook.data import prepare\n\n\nout = Path('/private/tmp/ngpt-updates-8bff3c9-learning.json')\nassert not out.exists()\ndata = Path('/private/tmp/ngpt-updates-8bff3c9-story-v20')\nprepare(Path('src/nanogpt_macbook/demo.txt'), data, validation_fraction=0.2)\nengine.select_device('gpu', 2)\nrecord = dict(source=source_info(), runner_source=Path(__file__).read_text(), method=dict(preset='medium', steps=100, seeds=[11,29,1337], eval_every=20, eval_batches=4, queue=2, memory_gib=2, source='bundled demo.txt', validation_fraction=0.2), results=[])\nconfig, training = PRESETS['medium']\nupdated = engine.update_parameters\n\n\ndef native(model, optimizer, gradients):\n    optimizer.update(model, gradients)\n\n\nfor index, seed in enumerate([11,29,1337]):\n    paths = [('reference',native),('updated',updated)]\n    if index % 2:\n        paths.reverse()\n    result = dict(seed=seed,runs={})\n    for name, implementation in paths:\n        gc.collect()\n        mx.clear_cache()\n        run = Path(f'/private/tmp/ngpt-updates-8bff3c9-v20-{seed}-{name}')\n        assert not run.exists()\n        with patch.object(engine,'update_parameters',implementation):\n            state = engine.train(data,run,config,replace(training,seed=seed),100,eval_every=20,eval_batches=4,log_every=20,report=lambda _:None)\n        latest,_ = checkpoint.read(run)\n        rows = [json.loads(line) for line in (run/'metrics.jsonl').read_text().splitlines()]\n        evaluations = [row for row in rows if 'val_loss' in row]\n        result['runs'][name] = dict(path=str(run),checkpoint=str(latest),state=state,metrics=rows,final_val_loss=evaluations[-1]['val_loss'])\n        print(seed,name,'final validation',evaluations[-1]['val_loss'],flush=True)\n    differences = []\n    for file in ['model.safetensors','optimizer.safetensors','random.safetensors']:\n        a = mx.load(str(Path(result['runs']['reference']['checkpoint'])/file))\n        b = mx.load(str(Path(result['runs']['updated']['checkpoint'])/file))\n        assert a.keys()==b.keys()\n        maximum, changed, total = 0,0,0\n        for key in a:\n            aa,bb = np.array(a[key]),np.array(b[key])\n            assert aa.shape==bb.shape and aa.dtype==bb.dtype\n            changed += int(np.count_nonzero(aa!=bb))\n            total += aa.size\n            maximum = max(maximum,float(np.max(np.abs(aa.astype(float)-bb.astype(float)),initial=0)))\n        differences.append(dict(file=file,elements=total,changed_elements=changed,max_abs_difference=maximum))\n    result['differences'] = differences\n    result['final_validation_difference'] = result['runs']['updated']['final_val_loss']-result['runs']['reference']['final_val_loss']\n    record['results'].append(result)\n    out.write_text(json.dumps(record,indent=2)+'\\n')\n    print(seed,differences,flush=True)\n",
